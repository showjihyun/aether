[importlinter]
root_packages =
    aether_api
    aether_cli
    aether_worker
    aether_runtime
    aether_workflow
    aether_context
    aether_memory
    aether_mcp
    aether_policy
    aether_evaluation
include_external_packages = True

[importlinter:contract:ar2-packages-do-not-know-apps]
name = AR-2 packages/* must not import apps/*
type = forbidden
source_modules =
    aether_runtime
    aether_workflow
    aether_context
    aether_memory
    aether_mcp
    aether_policy
    aether_evaluation
forbidden_modules =
    aether_api
    aether_worker

[importlinter:contract:ar3-runtime-direction]
name = AR-3 mcp, context and memory must not import runtime
type = forbidden
source_modules =
    aether_mcp
    aether_context
# aether_memory 는 Phase 3 이 이 패키지를 만들면서 빠졌습니다(2026-10-12 확인).
# aether_context 와 같은 자리입니다 — runtime 이 쓰고 역방향은 없습니다. 실제 위반은
# 없었지만 막는 것이 없었습니다. 근거: spec 0005 D-10.
    aether_memory
forbidden_modules =
    aether_runtime

# spec 0005 D-10 (Phase 4): 방향이 **반대**입니다 — workflow 가 runtime 을 쓰고
# runtime 은 workflow 를 모릅니다. AR-3 에 넣으면 이름과 내용이 어긋나므로 번호를
# 새로 씁니다(AR-1 ~ AR-12 가 쓰였습니다).
#
# 이 계약을 P4-1 보다 **앞에** 세우는 이유: 계약이 먼저 있으면 첫 workflow 코드가
# 처음부터 위반할 수 없습니다. 지금은 packages/workflow 가 구현 0행이라 이 계약이
# 공허하게 통과하지만, 그 상태는 Phase 2 의 AR-6·Phase 3 의 AR-3 과 같습니다 —
# 코드가 생기면서 발화합니다. 발화 여부는 tests/arch 의 주입 테스트가 지금 판정합니다.
[importlinter:contract:ar13-runtime-does-not-know-workflow]
name = AR-13 runtime must not import workflow
type = forbidden
source_modules =
    aether_runtime
forbidden_modules =
    aether_workflow

# spec 0006 D-2 (MVP 통합): CLI 는 **제품 코드를 import 하지 않습니다.** AR-1 의 CLI 판은
# "packages/sdk 만 쓴다" 였는데 그 SDK 는 TypeScript 이고 사람이 CLI 를 **Python** 으로
# 고르면서(2026-10-17) 문자 그대로 지킬 수 없게 됐습니다. 규칙의 뜻 — 공개 계약
# (packages/sdk/openapi.json)만 쓰고 제품 코드를 보지 않는다 — 을 이 계약이 강제합니다.
# AR-1 ~ AR-13 이 쓰였으므로 번호는 14 입니다.
#
# 이 계약을 MVP-1(CLI 구현)보다 **앞에** 세우는 이유: 계약이 먼저 있으면 첫 CLI 코드가
# 처음부터 위반할 수 없습니다(AR-13 을 P4-1 앞에 둔 것과 같은 순서, plan 0006 Wave 0).
# 지금 `aether_cli` 에는 import 가 한 줄도 없어 이 계약은 **무엇도 막지 않습니다** —
# 그래서 유일한 증거는 tests/arch 의 주입 케이스입니다(AR-6·AR-13 도 같은 상태를 지났습니다).
#
# 이 금지 목록은 **손으로 유지되는 denylist** 입니다 — 새 제품 패키지가 생기면 여기에
# 더해야 하고, 빠지면 CLI 가 그것을 import 해도 이 계약이 침묵합니다(2026-10-17 에
# `aether_evaluation` 이 실제로 빠져 있었습니다). 그래서 완전성을 사람의 기억에 맡기지
# 않고 `tests/arch/test_ar14_denylist_is_complete.py` 가 워크스페이스 멤버와 비교해
# 고정합니다 — 새 패키지를 추가하면 그 테스트가 먼저 실패합니다.
[importlinter:contract:ar14-cli-does-not-import-product]
name = AR-14 cli must not import product packages
type = forbidden
source_modules =
    aether_cli
forbidden_modules =
    aether_api
    aether_runtime
    aether_workflow
    aether_worker
    aether_mcp
    aether_policy
    aether_context
    aether_memory
    aether_evaluation

[importlinter:contract:ar4-policy-judges-only]
name = AR-4 policy must not import runtime, mcp, context
type = forbidden
source_modules =
    aether_policy
forbidden_modules =
    aether_runtime
    aether_mcp
    aether_context

[importlinter:contract:ar12-mcp-sees-policy-inbound-ports-only]
name = AR-12 mcp -> policy: inbound ports only
type = forbidden
source_modules =
    aether_mcp
forbidden_modules =
    aether_policy.adapters
    aether_policy.application.usecases
    aether_policy.application.ports.outbound

[importlinter:contract:ar5-llm-sdk-only-in-model-gateway]
name = AR-5 LLM SDKs and LLM HTTP only inside aether_runtime.adapters.outbound.model_gateway
type = forbidden
source_modules =
    aether_api
    aether_cli
    aether_worker
    aether_runtime
    aether_workflow
    aether_context
    aether_memory
    aether_mcp
    aether_policy
    aether_evaluation
forbidden_modules =
    openai
    anthropic
    google
    httpx
ignore_imports =
    aether_runtime.adapters.outbound.model_gateway.** -> httpx
unmatched_ignore_imports_alerting = error
# spec 0002 D-13(개정 1), plan 0002 부록 A — H-4(P1-3 병합 뒤 한 번).
# 벤더 SDK(openai·anthropic·google)의 ignore 는 두지 않습니다: Phase 1 에 그 어댑터가 없어
# 매칭되지 않고, error 는 매칭되지 않는 ignore 를 실패로 봅니다(import-linter contract_utils).
# SDK 어댑터가 생기는 Phase 에 그 줄을 다시 넣습니다. forbidden 은 그대로 걸립니다.
# httpx 는 OpenAI-호환 어댑터(P1-3)가 벤더 SDK 대신 쓰는 HTTP 클라이언트라 같은 자리에서만 허용.

[importlinter:contract:ar6-mcp-client-only-in-mcp]
name = AR-6 MCP client library only inside aether_mcp
type = forbidden
source_modules =
    aether_api
    aether_worker
    aether_runtime
    aether_workflow
    aether_context
    aether_memory
    aether_policy
    aether_evaluation
forbidden_modules =
    mcp
ignore_imports =
    aether_worker.main -> aether_mcp.adapters.outbound.mcp_client.stdio
    aether_worker.main -> aether_mcp.adapters.outbound.mcp_client.http
unmatched_ignore_imports_alerting = error
# spec 0003 2.1 — 조립은 worker 의 main 이 합니다. 이 계약은 전이 import 까지 잡으므로
# 조립 지점 하나를 예외로 둡니다(AR-5 의 model_gateway.** -> httpx 와 같은 모양,
# 사람 결정 2026-09-27, P2-3 실측). 다른 경로는 그대로 막힙니다 — http 전송을 조립하게
# 되면 그 줄을 따로 추가합니다(matched 되지 않는 ignore 는 error 입니다).

[importlinter:contract:ar7-control-does-not-call-data]
name = AR-7 api must not import worker, nor runtime execution layers
type = forbidden
source_modules =
    aether_api
forbidden_modules =
    aether_worker
    aether_runtime.application
    aether_runtime.adapters
# spec 0002 2.1·2.12(D-13): aether_runtime.domain 은 허용 — AgentDefinition, RunStatus, 이벤트 타입.
# Control Plane 은 타입만 알고 실행(application·adapters)을 모릅니다.

# --- 패키지 안의 방향 (architecture.md 3.1) -----------------------------------

[importlinter:contract:ar8-inward-only]
name = AR-8 adapters -> application -> domain, inward only, in every package
type = layers
layers =
    adapters
    application
    domain
containers =
    aether_api
    aether_worker
    aether_runtime
    aether_workflow
    aether_context
    aether_memory
    aether_mcp
    aether_policy
    aether_evaluation

[importlinter:contract:ar9-core-is-framework-free]
name = AR-9 domain and application import no framework or I/O
type = forbidden
source_modules =
    aether_api.domain
    aether_api.application
    aether_worker.domain
    aether_worker.application
    aether_runtime.domain
    aether_runtime.application
    aether_workflow.domain
    aether_workflow.application
    aether_context.domain
    aether_context.application
    aether_memory.domain
    aether_memory.application
    aether_mcp.domain
    aether_mcp.application
    aether_policy.domain
    aether_policy.application
    aether_evaluation.domain
    aether_evaluation.application
forbidden_modules =
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    asyncpg
    redis
    httpx
    aiohttp
    requests
    opentelemetry
    openai
    anthropic
    google
    mcp

[importlinter:contract:ar11-inbound-does-not-import-outbound]
name = AR-11 inbound adapters do not import outbound adapters
type = forbidden
source_modules =
