# language/java/backend/harness.config.example
#
# Java(Spring, Gradle) 백엔드 프로젝트용 HARNESS_STEPS 예시입니다. 프로젝트 루트의 harness.config 에
# 이 배열만 옮겨 적습니다. 나머지 키(HARNESS_EVAL_WEIGHTS, HARNESS_THRESHOLD, HARNESS_MAX_ITERATIONS 등)의
# 설명과 기본값은 harness/scripts/harness.config.example 이 정본입니다.
#
#   cp harness/scripts/harness.config.example ./harness.config
#   # 아래 HARNESS_STEPS 를 ./harness.config 에 붙여 넣습니다.
#
# 형식: "id|layer|required|command"
# 아래 명령은 Gradle 래퍼 기준입니다. Maven 은 주석의 대응 명령을 씁니다.

HARNESS_STEPS=(
  # 컴파일이 깨지면 나머지 단계는 의미가 없으므로 첫 필수 단계입니다.
  "compile|correctness|true|./gradlew --console=plain classes testClasses"
  #                                    mvn: ./mvnw -B -q test-compile

  # 정적 검사. checkstyle·spotbugs·pmd 는 check 에 묶여 있고, 테스트는 아래에서 따로 돌립니다.
  "lint|quality|true|./gradlew --console=plain check -x test"
  #                   mvn: ./mvnw -B -DskipTests checkstyle:check spotbugs:check

  # ArchUnit 테스트만 골라 architecture 계층으로 채점합니다. 테스트 클래스 이름 규약이 필요합니다.
  "arch-test|architecture|true|./gradlew --console=plain test --tests '*ArchitectureTest'"
  #                             mvn: ./mvnw -B test -Dtest='*ArchitectureTest'

  # 단위 테스트. 아키텍처 테스트는 위에서 돌렸으므로 제외합니다.
  "unit|correctness|true|./gradlew --console=plain test -x integrationTest"
  #                       mvn: ./mvnw -B test

  # 통합 테스트(OBS-B1). Testcontainers 나 임베디드 DB 를 쓰는 source set 입니다.
  "integration|correctness|true|./gradlew --console=plain integrationTest"
  #                              mvn: ./mvnw -B -DskipUnitTests failsafe:integration-test failsafe:verify

  # 기동 후 스모크(OBS-B2). 앱을 띄우는 스크립트는 프로젝트가 소유합니다.
  "smoke|behavior|false|./scripts/smoke.sh"

  # 부하 테스트(OBS-B7). 성능 계층을 채점하기로 결정한 뒤에만 켭니다.
  "load|performance|false|k6 run load/smoke.js"
)

# 감지 결과를 강제로 재정의해야 할 때만 사용합니다.
# HARNESS_STACK="java:gradle"
# HARNESS_KIND="backend"
