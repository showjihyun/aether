# infra/docker/compose.yaml 이 읽는 전체 키입니다(spec 0001 2.7·2.3).
# 사용: cp infra/docker/.env.example infra/docker/.env 후 <generate> 를 실제 값으로 채웁니다.
# 이 파일(.env.example)은 커밋 대상이지만, 채운 뒤의 `.env` 는 .gitignore 가 제외합니다
# (AGENTS.md Trust — 비밀값을 코드·로그·커밋에 남기지 않습니다).

# PostgreSQL 관리자 계정. migrate 서비스가 이 역할로 스키마·테이블·GRANT 를 만듭니다.
# 이름 자체는 비밀이 아니라 개발 기본값을 둡니다.
POSTGRES_USER=aether_admin
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=aether

# spec 2.8 의 두 런타임 역할 비밀값. infra/docker/postgres/init/01-roles.sh 가 이 값으로
# aether_control / aether_data 역할을 만듭니다.
AETHER_CONTROL_PASSWORD=<generate>
AETHER_DATA_PASSWORD=<generate>

# 예시 생성 명령: openssl rand -hex 24

# 빌드 인자(→ 이미지 env, /healthz 의 version). README 의 기동 명령이 셸에서
# `AETHER_VERSION=$(git describe --tags --always)` 로 덮어씁니다 — 여기 값은 그
# 접두사 없이 실행했을 때만 쓰이는 기본값입니다.
AETHER_VERSION=dev

# spec 0002 2.5, 2.15, D-1 (P1-3): model gateway 선택. 기본은 fake — 판정(verify·smoke,
# R-6)은 항상 fake 로 네트워크 없이 갑니다(C-7). `openai_compatible` 로 바꾸면 worker 가
# 실제 로컬 LLM 서버(Ollama, compose `llm` 프로파일)를 부릅니다 — 사람의 수동 확인용이며
# 이 값 자체는 판정 대상이 아닙니다. 루트 README "실제 모델로 돌리기" 참고.
AETHER_MODEL_ADAPTER=fake

# `AETHER_MODEL_ADAPTER=openai_compatible` 일 때만 씁니다. compose `llm` 프로파일 안에서는
# `http://llm:11434/v1`(호스트에 공개하지 않는 서비스 이름 — 위 llm 서비스 참고).
AETHER_MODEL_BASE_URL=http://llm:11434/v1

# 기본 테스트 모델(D-1, Q6): Qwen3.8 27B 양자화, Ollama 태그 `qwen3.8:27b`(2026-09-12
# 확인: 존재, 약 18 GB, 256K 컨텍스트). 이 태그는 P1-3 PR 리뷰에서 사람이 한 번 더
# 확인합니다 — 사라졌으면 같은 계열의 최근접 모델로 바꾸고 improvement-log/ 에 기록.
AETHER_MODEL_ID=qwen3.8:27b

# 선택. 비밀값 — 채운 값은 절대 커밋하지 않습니다. 로컬 Ollama 는 보통 비워 둡니다.
AETHER_MODEL_API_KEY=<optional>

# spec 0002 2.5, D-19: Qwen3.8 계열은 기본이 thinking 이라 false 로 꺼 둡니다. true 로
# 켜면 응답에 <think> 블록/추가 지연이 생길 수 있습니다(reasoning 은 어댑터가 분리해
# ModelResponse.reasoning 으로 돌려주고, 로그·span·이벤트에는 넣지 않습니다).
AETHER_MODEL_THINKING=false

# spec 0004 2.9, D-3 (P3-2a): 임베딩 전용 모델 — 채팅 모델(AETHER_MODEL_ID)과 **다릅니다**.
# 지금까지 어댑터가 채팅 모델 id 를 /embeddings 로 그대로 보내 적재가 실패했습니다.
# 기본은 Ollama 의 nomic-embed-text(768 차원).
AETHER_EMBED_MODEL_ID=nomic-embed-text

# spec 0004 2.9, D-9 (P3-2a): 위 임베딩 모델의 차원. 마이그레이션 0004 의 벡터 열이
# 이 값으로 고정됩니다 — 모델을 바꾸면 차원도 함께 바뀌고, 불일치는 검색에서
# 재적재를 요구하는 오류로 드러납니다(자동 재적재는 하지 않습니다, C-3).
AETHER_EMBED_DIM=768

# spec 0003 2.9, D-2 (P2-6): `AgentDefinition.mcp_servers` 의 `ref` 를 실제 명령·URL
# 로 푸는 표 — worker 가 읽습니다. `name=transport:target` 목록을 `;` 로 구분합니다.
# 자격증명은 target 안의 `${VAR}` 참조로만 넣습니다(이 값 자체를 로그·감사·이벤트에
# 남기지 않습니다, R-11). 비워 두면 compose.yaml 의 기본값(이미지에 빌드 시점부터
# 들어 있는 Filesystem MCP Server, D-8)이 그대로 씁니다 — 이 변수를 여기서 채우면
# 그 기본값을 완전히 덮어씁니다.
#
# D-8: 참조 서버는 실행 시 `npx` 로 내려받지 않습니다 — Air-Gapped 에서 동작하지
# 않고 공급망 관점에서도 받을 수 없습니다. 이미지 안 실제 경로를 직접 부릅니다.
# 예(기본값과 같은 모양 — Filesystem 의 허용 디렉터리만 바꾸고 싶을 때):
#   AETHER_MCP_SERVERS=filesystem=stdio:node /usr/local/lib/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js /다른/디렉터리
#
# PostgreSQL(우리 구현, D-7)은 이 표만으로는 쓸 수 없습니다 — 그 서버는 자격증명을
# 환경변수(`AETHER_POSTGRES_READONLY_URL`)로 받는데, stdio 항목은 지금 명령/인자만
# 풀고 서브프로세스 환경변수는 넘기지 않습니다(`_resolve_mcp_servers`, spec 2.9).
# `api-integration` 이 이 서버를 직접 env 를 주입해 판정합니다(R-8 절반) — compose
# 로 실제 Agent 가 이 서버를 쓰게 하려면 그 env 전달 경로가 먼저 필요하고, 이번
# 단위(P2-5 1단계) 범위 밖입니다(구현자 보고 참고).
AETHER_MCP_SERVERS=

# spec 0002 2.9, D-7 (P1-8): otel-collector 의 file exporter 출력을 호스트에서 보는
# bind mount 경로. 기본값(compose.yaml 의 ${AETHER_OTEL_DIR:-./out/otel})으로 충분하면
# 이 줄은 채우지 않아도 됩니다.
# AETHER_OTEL_DIR=./out/otel
