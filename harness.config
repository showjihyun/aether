# harness.config — aether(Open Hybrid Enterprise AI OS)의 하네스 설정입니다.
#
# 키의 의미와 기본값은 harness/scripts/harness.config.example 이 정본입니다.
# 언어별 예시는 harness/language/<언어>/<kind>/harness.config.example 에 있습니다.
#
# ---------------------------------------------------------------------------
# 현재 위치: AD-2 (Week 1~) / 성숙도 L2 진입 시도
#
# 앞 여섯 단계는 하네스 자신(harness/scripts/self-check.sh)을, 뒤 단계들은 제품 코드를
# 검사합니다. 제품 단계는 Phase 0 에서 10개(spec 0001 2.11, D-7), Phase 1 에서 smoke 를
# 더해 11개(spec 0001 개정 12, spec 0002 D-15), AD-2 에서 성능 판정 bench 를 더해
# 12개입니다(근거: improvement-log/2026-09-17-004.yaml — 단계 상한은 사람이 소유, EI-2).
# 없는 코드를 검사하는 단계를 미리
# 적지 않습니다 — verify 가 항상 실패하거나 required 를 내리게 되어 게이트가 죽습니다.
#
# 이 파일은 보호 파일입니다. 변경은 harness/rules/harness-change-control.rule.md 를
# 따르고 harness-change 라벨 PR 로 사람이 병합합니다.

# ---------------------------------------------------------------------------
# HARNESS_STEPS — 형식: "id|layer|required|command"
#
# 계층별로 나눠 등록합니다. 한 덩어리로 두면 무엇이 깨졌는지 계층 점수에 드러나지
# 않습니다(EI-4: 총점만으로 판정하지 않습니다).
HARNESS_STEPS=(
  # 번들의 모든 bash 스크립트가 파싱되고 진입점이 실행 가능한가.
  # 깨지면 나머지가 의미 없으므로 첫 단계입니다.
  "syntax|correctness|true|harness/scripts/self-check.sh --only syntax"

  # 언어 팩이 계약을 지키는가. 어기면 그 언어의 보호 패턴과 기본 단계가 사라집니다.
  # aether 는 python 팩과 typescript 팩을 둘 다 씁니다(FastAPI + Next.js).
  "packs|architecture|true|harness/scripts/self-check.sh --only packs"

  # 보호 목록이 스택 감지와 무관하게 병합되는가. 평가 무결성 게이트입니다.
  "protection|behavior|true|harness/scripts/self-check.sh --only protection"

  # 문서의 상대 링크가 전부 실재하는가. 발견 경로가 끊기면 문서는 없는 것과 같습니다.
  # HARNESS_SELF_CHECK_LINK_DIRS 로 이 프로젝트의 진입점 문서와 평가 세트도 함께 봅니다.
  "links|quality|true|harness/scripts/self-check.sh --only links"

  # 번들이 제공하는 improvement-log 예시가 스키마를 만족하는가.
  "log-schema|quality|true|harness/scripts/self-check.sh --only log-schema"

  # 번들에 파일을 더하고 README 트리를 갱신하지 않으면 발견 경로가 낡습니다.
  # links 는 링크 대상의 존재만 보므로 이 부류를 잡지 못합니다.
  "inventory|quality|true|harness/scripts/self-check.sh --only inventory"

  # --- Phase 0 제품 단계 (spec 0001 2.11, D-7). 싼 것부터. -----------------------
  "api-lint|quality|true|uv run ruff check . && uv run ruff format --check ."
  "api-typecheck|quality|true|uv run mypy"
  "api-arch|architecture|true|PYTHONUTF8=1 uv run lint-imports"
  "api-unit|correctness|true|uv run pytest -q -m 'not integration'"
  # 드리프트 검사는 재생성 결과를 HEAD 가 아니라 **작업 트리** 와 비교합니다
  # (scripts/check-sdk-drift.sh). HEAD 비교는 계약을 올바르게 바꾸고 생성물을
  # 정확히 재생성했더라도 커밋 전에는 반드시 실패해서, 커밋 권한 없이 일하는
  # 실행자가 이 단계를 초록으로 끝낼 수 없었습니다(2026-09-17 두 건:
  # evaluation/runs/2026-09-17-REP-7.md, 2026-09-17-REP-1-r2.md).
  # CI 는 깨끗한 체크아웃이라 작업 트리 = 커밋이므로 검출력은 같습니다.
  # 근거: improvement-log/2026-09-17-005.yaml.
  "web-typecheck|quality|true|scripts/check-sdk-drift.sh && pnpm -F web -F sdk run typecheck"
  "web-lint|quality|true|pnpm -F web -F sdk run lint"
  "web-arch|architecture|true|pnpm exec depcruise apps/web --config .dependency-cruiser.cjs"
  "web-unit|correctness|true|pnpm -F web -F sdk run test:unit"
  "web-build|correctness|true|pnpm -F web run build"
  "api-integration|correctness|true|uv run pytest -q -m integration"

  # --- Phase 1 behavior 단계 (spec 0002 2.11, D-15). 격리된 compose 프로젝트로
  # api·worker·postgres·redis·otel-collector 를 띄워 agent → run → succeeded 와
  # collector 파일의 trace_id 까지 확인합니다. 회귀 조건: 단독 ≤ 240초(로컬),
  # CI verify job ≤ 8분 — 넘으면 spec 0002 2.11 (a) 로 돌아가는 판정을 사람이 합니다.
  # 근거: improvement-log/2026-09-16-001.yaml (EI-2 — 단계 상한은 사람이 소유).
  # `--bench` 를 붙여 같은 스택에서 Run 생성 지연까지 측정합니다(스택을 두 번 띄우지
  # 않기 위해서입니다). 결과는 infra/docker/out/smoke-bench.json 이고 판정은 다음
  # 단계가 합니다 — 측정과 판정을 한 단계에 묶으면 어느 쪽이 깨졌는지 계층 점수에
  # 드러나지 않습니다(EI-4).
  "smoke|behavior|true|scripts/smoke.sh --bench"

  # --- AD-2 performance 단계. 위 smoke 가 남긴 p95 를 아래 HARNESS_BENCH_P95_MAX_MS
  # 와 비교합니다. 이 단계가 없던 동안 performance 계층 점수는 null 이었고, 실제로
  # Run 생성 경로에 N+1 을 심은 트리가 verify 17/17 을 통과했습니다(2026-09-17,
  # evaluation/runs/2026-09-17-REP-8-r2.md — 그때 벤치 p95 는 1613 ms).
  # 근거: improvement-log/2026-09-17-004.yaml.
  "bench|performance|true|scripts/check-bench.sh"
)

# ---------------------------------------------------------------------------
# HARNESS_EVAL_WEIGHTS — 기본값을 그대로 씁니다. 근거 없이 조정하지 않습니다.
# 단계가 없는 계층(performance, subjective)은 score 가 null 이 되고 가중치는 재분배됩니다.
HARNESS_EVAL_WEIGHTS=(
  "correctness|0.30"
  "architecture|0.20"
  "quality|0.20"
  "behavior|0.15"
  "performance|0.10"
  "subjective|0.05"
)

# ---------------------------------------------------------------------------
# 합격선은 가중 평균에만 걸립니다. "한 단계라도 실패하면 불합격" 은 이 숫자가 아니라
# eval.sh 의 failed_required 판정(EV-5)이 담당합니다. 불리언을 임계값 산술로 대신
# 표현하지 않습니다.
#
# Phase 0 제품 코드 단계가 들어와 harness-adoption.md AD-2(Week 1)에 진입했으므로
# 시작값 80 으로 낮춥니다. 근거: improvement-log/2026-09-11-001.yaml
# (EI-2 — 임계값은 사람이 소유, 변경은 improvement-log 근거와 짝을 이룹니다).
HARNESS_THRESHOLD=80

# ---------------------------------------------------------------------------
# Run 생성 응답 P95 의 상한(ms). evaluation/README.md 의 {{성능_기준}} 과 같은 값이며
# 그 문서가 측정 정의(scripts/smoke.sh --bench, 워밍업 20 제외 n=180, api 컨테이너
# 안에서 측정)와 근거(2026-09-16 실측 p95 36.8 ms 의 약 4배 여유)를 갖습니다.
# scripts/check-bench.sh 가 이 변수만 읽습니다 — 스크립트에는 기본값이 없어서 이
# 줄을 지우면 게이트가 통과가 아니라 실패합니다.
# 값은 사람이 고정했습니다(showjihyun, 2026-09-16, EI-2). 근거 문서:
# improvement-log/2026-09-17-004.yaml.
HARNESS_BENCH_P95_MAX_MS=150

HARNESS_MAX_ITERATIONS=8
HARNESS_MAX_SAME_FAILURE=3
HARNESS_NO_IMPROVEMENT_ROUNDS=2

# loop.sh 가 각 라운드마다 실행할 에이전트 명령입니다. 비우면 dry-run 으로 프롬프트만 출력합니다.
HARNESS_AGENT_CMD=""

# ---------------------------------------------------------------------------
# self-check 의 링크 검사에 이 프로젝트의 문서도 포함시킵니다.
# 진입점 문서와 평가 세트의 링크가 끊기면 에이전트의 탐색 경로가 사라집니다.
# 경로는 프로젝트 루트 기준이며 공백으로 구분합니다.
# 존재하지 않는 경로를 적으면 links 단계가 실패합니다(설정 오류로 봅니다).
HARNESS_SELF_CHECK_LINK_DIRS="AGENTS.md CLAUDE.md PROVENANCE.md docs intents specs plans evaluation improvement-log"
